# PostgreSQL TCP connection string (Prisma Postgres, Neon, or local PostgreSQL)
# Use postgres:// or postgresql://, not a prisma:// or prisma+postgres:// URL.
POSTGRES_DATABASE_URL="postgres://af6dc9ce7e2729c748125b838ebf61a821b5140b3aad1b1341914f60a6a84f82:sk_iBfHvjHD0we9mSzizE25j@db.prisma.io:5432/postgres?sslmode=require"

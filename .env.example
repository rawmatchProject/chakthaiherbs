# PostgreSQL TCP connection string (Prisma Postgres, Neon, or local PostgreSQL)
# Use postgres:// or postgresql://, not a prisma:// or prisma+postgres:// URL.
POSTGRES_URL=postgresql://127.0.0.1:5432/your-database-name
# DATABASE_URL is also supported when POSTGRES_URL is unset.

# Connect a public Vercel Blob store to the project to populate this server-only token.
# Leave empty to use local media storage during development.
BLOB_READ_WRITE_TOKEN=

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

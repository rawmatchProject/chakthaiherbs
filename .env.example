POSTGRES_PRISMA_DATABASE_URL="postgres://af6dc9ce7e2729c748125b838ebf61a821b5140b3aad1b1341914f60a6a84f82:sk_iBfHvjHD0we9mSzizE25j@db.prisma.io:5432/postgres?sslmode=require"
# DATABASE_URL is also supported when POSTGRES_URL is unset.

# Server-only read/write token for the existing Vercel Blob store.
# Leave empty to use local media storage during development.
BLOB_READ_WRITE_TOKEN=
# Must match the store. Private is the application's default.
BLOB_ACCESS=private

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE
